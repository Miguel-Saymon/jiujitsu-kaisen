<div class="tab jk-notas-tab jk-votos-tab" data-group="primary" data-tab="votos">
  <div class="jk-notas-grid">
    <section class="jk-card jk-notas-card">
      <h2>Votos Próprios</h2>
      <textarea
        name="system.votos.proprios"
        placeholder="Registre os votos próprios do personagem, suas condições, benefícios e consequências..."
      >{{system.votos.proprios}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Votos Contratuais</h2>
      <textarea
        name="system.votos.contratuais"
        placeholder="Registre os votos contratuais, as partes envolvidas, condições, benefícios e consequências..."
      >{{system.votos.contratuais}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Votos Emergenciais</h2>
      <textarea
        name="system.votos.emergenciais"
        placeholder="Registre os votos emergenciais, suas condições temporárias, benefícios e consequências..."
      >{{system.votos.emergenciais}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Votos de Restrição Celeste</h2>
      <textarea
        name="system.votos.restricaoCeleste"
        placeholder="Registre a Restrição Celeste, suas limitações, benefícios e características..."
      >{{system.votos.restricaoCeleste}}</textarea>
    </section>
  </div>
</div>

