<div class="tab" data-group="primary" data-tab="combate">

    <div class="jk-combate-layout">

        {{!-- LINHA SUPERIOR --}}
        <div class="jk-combate-top-row">

            <section class="jk-card jk-combate-card">
                <h2>Características</h2>

                <textarea
                    class="jk-free-field jk-characteristics-field"
                    name="system.combate.caracteristicas"
                    data-auto-resize="true"
                    placeholder="Campo livre..."
                >{{system.combate.caracteristicas}}</textarea>
            </section>

            <section class="jk-card jk-combate-card">
                <header class="jk-combat-section-header">
                    <h2>Habilidades &amp; Talentos</h2>
                    <button
                        class="jk-add-combat-row"
                        type="button"
                        data-path="combate.habilidades"
                        data-prefix="habilidade"
                        title="Adicionar habilidade ou talento"
                    ><i class="fa-solid fa-plus"></i></button>
                </header>

                <table class="jk-talent-table jk-ability-table">
                    <colgroup>
                        <col class="is-name-col">
                        <col class="is-value-col">
                        <col class="is-value-col">
                        <col class="is-cost-col">
                        <col class="is-actions-col">
                        <col class="is-delete-col">
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Atual</th>
                            <th>Max.</th>
                            <th>Custo</th>
                            <th class="jk-actions-heading">Ações</th>
                            <th class="jk-delete-heading" title="Remover"></th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each combateHabilidades as |habilidade|}}
                        <tr class="jk-ability-row" data-ability-key="{{habilidade.key}}">
                            <td>
                                <div class="jk-ability-identity">
                                    <button class="jk-drag-ability" type="button" draggable="true" title="Arrastar para reorganizar" tabindex="-1"><i class="fas fa-grip-vertical"></i></button>
                                    <div
                                    class="jk-description-hover jk-name-description-hover"
                                    data-description="{{habilidade.descricao}}"
                                >
                                    <input
                                        name="system.combate.habilidades.{{habilidade.key}}.nome"
                                        type="text"
                                        value="{{habilidade.nome}}"
                                        placeholder="+ nova habilidade"
                                    />
                                    </div>
                                </div>
                            </td>
                            <td class="is-val">
                                <input
                                    name="system.combate.habilidades.{{habilidade.key}}.atual"
                                    type="number"
                                    value="{{habilidade.atual}}"
                                />
                            </td>
                            <td class="is-val">
                                <input
                                    name="system.combate.habilidades.{{habilidade.key}}.max"
                                    type="number"
                                    value="{{habilidade.max}}"
                                />
                            </td>
                            <td class="is-cost">
                                <input
                                    name="system.combate.habilidades.{{habilidade.key}}.custo"
                                    type="text"
                                    value="{{habilidade.custo}}"
                                />
                            </td>
                            <td class="jk-ability-actions">
                                <button
                                    class="jk-roll-habilidade"
                                    type="button"
                                    data-key="{{habilidade.key}}"
                                    title="Enviar habilidade para o chat"
                                ><i class="fas fa-dice-d20 jk-roll-icon"></i></button>
                                <button
                                    class="jk-toggle-description-row jk-description-button"
                                    type="button"
                                    data-target="habilidade-desc-{{habilidade.key}}"
                                    data-description="{{habilidade.descricao}}"
                                    title="Editar descrição"
                                ><i class="fas fa-pen"></i></button>
                            </td>
                            <td class="jk-delete-cell">
                                <button
                                    class="jk-remove-combat-row jk-row-delete"
                                    type="button"
                                    data-path="combate.habilidades"
                                    data-key="{{habilidade.key}}"
                                    data-prefix="habilidade"
                                    title="Remover habilidade ou talento"
                                ><i class="fas fa-xmark jk-delete-x-icon"></i></button>
                            </td>
                        </tr>
                        <tr class="jk-description-row" data-row="habilidade-desc-{{habilidade.key}}">
                            <td colspan="6">
                                <textarea
                                    class="jk-description-field"
                                    name="system.combate.habilidades.{{habilidade.key}}.descricao"
                                    placeholder="Descrição da habilidade ou talento..."
                                >{{habilidade.descricao}}</textarea>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </section>

        </div>

        {{!-- LINHA PRINCIPAL --}}
        <div class="jk-combate-mid-row">

            <div class="jk-combate-mid-left">

                <section class="jk-combate-cd-row">

                    <div class="jk-combat-box jk-combate-cd-box">
                        <h3>CD Especialização</h3>

                        <div class="jk-combat-total">
                            {{system.combate.cd.total}}
                        </div>


                        <div class="jk-combat-fields">
                            <label>
                                Atr.
                                <select name="system.combate.cd.atributo">
                                    <option value="forca" {{#if (eq system.combate.cd.atributo "forca")}}selected{{/if}}>FOR</option>
                                    <option value="destreza" {{#if (eq system.combate.cd.atributo "destreza")}}selected{{/if}}>DES</option>
                                    <option value="constituicao" {{#if (eq system.combate.cd.atributo "constituicao")}}selected{{/if}}>CON</option>
                                    <option value="inteligencia" {{#if (eq system.combate.cd.atributo "inteligencia")}}selected{{/if}}>INT</option>
                                    <option value="sabedoria" {{#if (eq system.combate.cd.atributo "sabedoria")}}selected{{/if}}>SAB</option>
                                    <option value="presenca" {{#if (eq system.combate.cd.atributo "presenca")}}selected{{/if}}>PRE</option>
                                </select>
                            </label>

                            <label>
                                Outros
                                <input
                                    name="system.combate.cd.outros"
                                    type="number"
                                    value="{{system.combate.cd.outros}}"
                                />
                            </label>
                        </div>
                    </div>

                    <div class="jk-combat-box jk-combate-desloc-box">
                        <h3>Deslocamento</h3>

                        <div class="jk-combat-total">
                            <span class="jk-deslocamento-total">{{deslocamentoTotal}}</span>
                            <span class="jk-unit">m</span>
                        </div>

                        <div class="jk-combat-fields">
                            <label>
                                Metros
                                <input
                                    name="system.combate.deslocamento"
                                    type="number"
                                    value="{{system.combate.deslocamento}}"
                                />
                            </label>

                            <label>
                                Outros
                                <input
                                    name="system.combate.deslocamentoOutros"
                                    type="number"
                                    value="{{system.combate.deslocamentoOutros}}"
                                />
                            </label>
                        </div>
                    </div>

                </section>

                <section class="jk-card jk-combate-card">
                    <h2>RDs</h2>

                    <div class="jk-rd-grid">
<label class="jk-rd-box rd-cor"><span class="jk-rd-box__label">COR</span><input class="jk-rd-box__input" name="system.combate.rd.cor" type="number" value="{{system.combate.rd.cor}}" /></label>
<label class="jk-rd-box rd-imp"><span class="jk-rd-box__label">IMP</span><input class="jk-rd-box__input" name="system.combate.rd.imp" type="number" value="{{system.combate.rd.imp}}" /></label>
<label class="jk-rd-box rd-per"><span class="jk-rd-box__label">PER</span><input class="jk-rd-box__input" name="system.combate.rd.per" type="number" value="{{system.combate.rd.per}}" /></label>
<label class="jk-rd-box rd-con"><span class="jk-rd-box__label">CON</span><input class="jk-rd-box__input" name="system.combate.rd.con" type="number" value="{{system.combate.rd.con}}" /></label>
<label class="jk-rd-box rd-que"><span class="jk-rd-box__label">QUE</span><input class="jk-rd-box__input" name="system.combate.rd.que" type="number" value="{{system.combate.rd.que}}" /></label>
<label class="jk-rd-box rd-cho"><span class="jk-rd-box__label">CHO</span><input class="jk-rd-box__input" name="system.combate.rd.cho" type="number" value="{{system.combate.rd.cho}}" /></label>

<label class="jk-rd-box rd-son"><span class="jk-rd-box__label">SON</span><input class="jk-rd-box__input" name="system.combate.rd.son" type="number" value="{{system.combate.rd.son}}" /></label>
<label class="jk-rd-box rd-ene"><span class="jk-rd-box__label">ENE</span><input class="jk-rd-box__input" name="system.combate.rd.ene" type="number" value="{{system.combate.rd.ene}}" /></label>
<label class="jk-rd-box rd-psi"><span class="jk-rd-box__label">PSI</span><input class="jk-rd-box__input" name="system.combate.rd.psi" type="number" value="{{system.combate.rd.psi}}" /></label>
<label class="jk-rd-box rd-rad"><span class="jk-rd-box__label">RAD</span><input class="jk-rd-box__input" name="system.combate.rd.rad" type="number" value="{{system.combate.rd.rad}}" /></label>
<label class="jk-rd-box rd-nec"><span class="jk-rd-box__label">NEC</span><input class="jk-rd-box__input" name="system.combate.rd.nec" type="number" value="{{system.combate.rd.nec}}" /></label>
<label class="jk-rd-box rd-ven"><span class="jk-rd-box__label">VEN</span><input class="jk-rd-box__input" name="system.combate.rd.ven" type="number" value="{{system.combate.rd.ven}}" /></label>
                    </div>
                </section>

                <section class="jk-card jk-combate-card">
                    <h2>Resistências</h2>

                    <textarea
                        class="jk-free-field"
                        name="system.combate.resistencias"
                        placeholder="campo livre..."
                    >{{system.combate.resistencias}}</textarea>
                </section>

            </div>

            <section class="jk-card jk-combate-card jk-inventory-attack-card">
                <h2>Inventário &amp; Ataques</h2>

                <div class="jk-combat-list-block jk-attack-block" data-item-type="arma">
                    <header class="jk-combat-subheader">
                        <h3>Ataques</h3>
                        <button class="jk-create-actor-item" type="button" data-item-type="arma" title="Adicionar ataque"><i class="fas fa-plus"></i></button>
                    </header>

                    <table class="jk-combat-list-table jk-inventory-table jk-attack-table">
                        <colgroup><col class="is-name-col"><col class="is-info-col"><col class="is-info-col"><col class="is-info-col"><col class="is-qty-col"><col class="is-actions-col"><col class="is-delete-col"></colgroup>
                        <thead><tr><th>Nome</th><th>Bônus</th><th>Dano</th><th>Crítico</th><th>Peso</th><th class="jk-actions-heading">Ações</th><th class="jk-delete-heading"></th></tr></thead>
                        <tbody class="jk-sortable-item-list" data-item-type="arma">
                            {{#each combateAtaques as |ataque|}}
                            <tr class="jk-inventory-row {{#if ataque.equipado}}is-equipped{{/if}}" data-item-id="{{ataque.id}}">
                                <td><div class="jk-item-identity"><button class="jk-drag-item" type="button" draggable="true" title="Arrastar para reorganizar" tabindex="-1"><i class="fas fa-grip-vertical"></i></button><span class="jk-item-name" title="{{ataque.nome}}">{{ataque.nome}}</span></div></td>
                                <td class="is-small">{{ataque.bonus}}</td><td class="jk-attack-damage" title="{{ataque.dano}}">{{ataque.dano}}</td><td class="is-small">{{ataque.critico}}</td><td class="is-small">{{ataque.espacos}}</td>
                                <td class="jk-item-actions"><button class="jk-roll-weapon-attack" type="button" data-item-id="{{ataque.id}}" title="Rolar ataque"><i class="fas fa-dice-d20"></i></button><button class="jk-edit-actor-item" type="button" data-item-id="{{ataque.id}}" title="Editar"><i class="fas fa-pen"></i></button></td>
                                <td class="jk-delete-cell"><button class="jk-delete-actor-item jk-row-delete" type="button" data-item-id="{{ataque.id}}" title="Remover"><i class="fas fa-xmark"></i></button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="jk-combat-list-block" data-item-type="equipamento">
                    <header class="jk-combat-subheader"><h3>Equipamentos</h3><button class="jk-create-actor-item" type="button" data-item-type="equipamento" title="Adicionar equipamento"><i class="fas fa-plus"></i></button></header>
                    <table class="jk-combat-list-table jk-inventory-table">
                        <colgroup><col class="is-name-col"><col class="is-info-col"><col class="is-info-col"><col class="is-qty-col"><col class="is-qty-col"><col class="is-actions-col"><col class="is-delete-col"></colgroup>
                        <thead><tr><th>Nome</th><th>Tipo</th><th>Defesa</th><th>Qtd.</th><th>Peso</th><th class="jk-actions-heading">Ações</th><th class="jk-delete-heading"></th></tr></thead>
                        <tbody class="jk-sortable-item-list" data-item-type="equipamento">
                            {{#each combateEquipamentos as |item|}}
                            <tr class="jk-inventory-row {{#if item.equipado}}is-equipped{{/if}}" data-item-id="{{item.id}}">
                                <td><div class="jk-item-identity"><button class="jk-drag-item" type="button" draggable="true" title="Arrastar para reorganizar" tabindex="-1"><i class="fas fa-grip-vertical"></i></button><span class="jk-item-name" title="{{item.nome}}">{{item.nome}}</span></div></td>
                                <td class="is-small" data-item-field="tipo">{{item.tipo}}</td><td class="is-small" data-item-field="defesa">{{item.defesa}}</td><td class="is-small" data-item-field="quantidade">{{item.quantidade}}</td><td class="is-small" data-item-field="espacos">{{item.espacos}}</td>
                                <td class="jk-item-actions"><button class="jk-toggle-equipped" type="button" data-item-id="{{item.id}}" title="{{#if item.equipado}}Desequipar equipamento{{else}}Equipar equipamento{{/if}}"><i class="fas {{#if item.equipado}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button><button class="jk-edit-actor-item" type="button" data-item-id="{{item.id}}" title="Editar"><i class="fas fa-pen"></i></button></td>
                                <td class="jk-delete-cell"><button class="jk-delete-actor-item jk-row-delete" type="button" data-item-id="{{item.id}}" title="Remover"><i class="fas fa-xmark"></i></button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="jk-combat-list-block" data-item-type="consumivel">
                    <header class="jk-combat-subheader"><h3>Consumíveis</h3><button class="jk-create-actor-item" type="button" data-item-type="consumivel" title="Adicionar consumível"><i class="fas fa-plus"></i></button></header>
                    <table class="jk-combat-list-table jk-inventory-table">
                        <colgroup><col class="is-name-col"><col class="is-info-col"><col class="is-info-col"><col class="is-qty-col"><col class="is-qty-col"><col class="is-actions-col"><col class="is-delete-col"></colgroup>
                        <thead><tr><th>Nome</th><th>Tipo</th><th>Preço</th><th>Qtd.</th><th>Peso</th><th class="jk-actions-heading">Ações</th><th class="jk-delete-heading"></th></tr></thead>
                        <tbody class="jk-sortable-item-list" data-item-type="consumivel">
                            {{#each combateConsumiveis as |item|}}
                            <tr class="jk-inventory-row" data-item-id="{{item.id}}">
                                <td><div class="jk-item-identity"><button class="jk-drag-item" type="button" draggable="true" title="Arrastar para reorganizar" tabindex="-1"><i class="fas fa-grip-vertical"></i></button><span class="jk-item-name" title="{{item.nome}}">{{item.nome}}</span></div></td>
                                <td class="is-small">{{item.tipo}}</td><td class="is-small">{{item.preco}}</td><td class="is-small">{{item.quantidade}}</td><td class="is-small">{{item.espacos}}</td>
                                <td class="jk-item-actions"><button class="jk-edit-actor-item" type="button" data-item-id="{{item.id}}" title="Editar"><i class="fas fa-pen"></i></button></td>
                                <td class="jk-delete-cell"><button class="jk-delete-actor-item jk-row-delete" type="button" data-item-id="{{item.id}}" title="Remover"><i class="fas fa-xmark"></i></button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="jk-combat-list-block" data-item-type="tesouro">
                    <header class="jk-combat-subheader"><h3>Tesouros</h3><button class="jk-create-actor-item" type="button" data-item-type="tesouro" title="Adicionar tesouro"><i class="fas fa-plus"></i></button></header>
                    <table class="jk-combat-list-table jk-inventory-table">
                        <colgroup><col class="is-name-col"><col class="is-info-col"><col class="is-info-col"><col class="is-qty-col"><col class="is-qty-col"><col class="is-actions-col"><col class="is-delete-col"></colgroup>
                        <thead><tr><th>Nome</th><th>Recip.</th><th>Preço</th><th>Qtd.</th><th>Peso</th><th class="jk-actions-heading">Ações</th><th class="jk-delete-heading"></th></tr></thead>
                        <tbody class="jk-sortable-item-list" data-item-type="tesouro">
                            {{#each combateTesouros as |item|}}
                            <tr class="jk-inventory-row" data-item-id="{{item.id}}">
                                <td><div class="jk-item-identity"><button class="jk-drag-item" type="button" draggable="true" title="Arrastar para reorganizar" tabindex="-1"><i class="fas fa-grip-vertical"></i></button><span class="jk-item-name" title="{{item.nome}}">{{item.nome}}</span></div></td>
                                <td class="is-small">{{#if item.recipiente}}Sim{{else}}Não{{/if}}</td><td class="is-small">{{item.preco}}</td><td class="is-small">{{item.quantidade}}</td><td class="is-small">{{item.espacos}}</td>
                                <td class="jk-item-actions"><button class="jk-edit-actor-item" type="button" data-item-id="{{item.id}}" title="Editar"><i class="fas fa-pen"></i></button></td>
                                <td class="jk-delete-cell"><button class="jk-delete-actor-item jk-row-delete" type="button" data-item-id="{{item.id}}" title="Remover"><i class="fas fa-xmark"></i></button></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="jk-carry-capacity {{#if cargaSobrecarregado}}is-overloaded{{/if}} {{#if cargaImpossivel}}is-impossible{{/if}}" title="Limite normal: {{cargaLimite}}. Máximo absoluto: {{cargaMaxima}}.">
                    <div class="jk-carry-capacity-header">
                        <span><i class="fas fa-weight-hanging"></i> Carga</span>
                        <strong>{{cargaAtual}} / {{cargaLimite}}</strong>
                    </div>
                    <div class="jk-carry-track" aria-label="Carga atual {{cargaAtual}}, limite {{cargaLimite}}, máximo {{cargaMaxima}}">
                        <div class="jk-carry-normal-limit" title="Limite normal"></div>
                        <div class="jk-carry-fill" style="width: {{cargaPercentual}}%;"></div>
                    </div>
                    <div class="jk-carry-capacity-meta">
                        {{#if cargaImpossivel}}
                            <span>Carga acima do máximo permitido ({{cargaMaxima}}).</span>
                        {{else}}
                            {{#if cargaSobrecarregado}}
                                <span>Sobrecarregado: -5 Defesa e -4,5 m de Deslocamento.</span>
                            {{else}}
                                <span>Limite: 8 + 2× modificador de Força.</span>
                            {{/if}}
                        {{/if}}
                        <span>Máx. {{cargaMaxima}}</span>
                    </div>
                </div>
            </section>

        </div>

    </div>

</div>
















