<div class="tab jk-notas-tab" data-group="primary" data-tab="notas">
  <div class="jk-notas-grid">
    <section class="jk-card jk-notas-card">
      <h2>Traços de Personalidade</h2>
      <textarea
        name="system.notas.personalidade"
        placeholder="Hábitos, atitudes, manias e características marcantes..."
      >{{system.notas.personalidade}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Ideais</h2>
      <textarea
        name="system.notas.ideais"
        placeholder="Princípios, crenças e objetivos que orientam o personagem..."
      >{{system.notas.ideais}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Ligações</h2>
      <textarea
        name="system.notas.ligacoes"
        placeholder="Pessoas, lugares, grupos ou promessas importantes..."
      >{{system.notas.ligacoes}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Complicações</h2>
      <textarea
        name="system.notas.complicacoes"
        placeholder="Fraquezas, conflitos, dívidas, medos ou problemas recorrentes..."
      >{{system.notas.complicacoes}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Domínio Inato</h2>
      <textarea
        name="system.notas.anotacoes"
        placeholder="Descreva o domínio inato, sua manifestação, características e observações..."
      >{{system.notas.anotacoes}}</textarea>
    </section>

    <section class="jk-card jk-notas-card">
      <h2>Informações Extras</h2>
      <textarea
        name="system.notas.informacoesExtras"
        placeholder="Registre informações adicionais, observações e detalhes importantes..."
      >{{system.notas.informacoesExtras}}</textarea>
    </section>
  </div>
</div>

