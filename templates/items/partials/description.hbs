<div class="jk-item-description-layout">
  <aside class="jk-item-description-stats">
    <div class="form-group">
      <label>PV</label>
      <input type="number" name="system.pv.atual" value="{{system.pv.atual}}" placeholder="Atual" />
      <input type="number" name="system.pv.max" value="{{system.pv.max}}" placeholder="Máx." />
    </div>

    <div class="form-group">
      <label>RD</label>
      <input type="number" name="system.rd" value="{{system.rd}}" />
    </div>

    <div class="form-group">
      <label>Quantidade</label>
      <input type="number" name="system.quantidade" value="{{system.quantidade}}" />
    </div>

    <div class="form-group">
      <label>Peso</label>
      <input type="number" min="0" step="0.1" name="system.espacos" value="{{system.espacos}}" />
    </div>

    <div class="form-group">
      <label>Preço</label>
      <input type="number" name="system.preco" value="{{system.preco}}" />
    </div>

    {{#if isTesouro}}
      <div class="form-group">
        <label>
          <input type="checkbox" name="system.tesouro.recipiente" {{checked system.tesouro.recipiente}} />
          Recipiente?
        </label>
      </div>
    {{/if}}
  </aside>

  <section class="jk-item-description-editor">
    <label>Descrição</label>
    {{editor system.descricao target="system.descricao" button=true owner=owner editable=editable}}
  </section>
</div>


