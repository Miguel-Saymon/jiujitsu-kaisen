<section class="jk-item-detail-section">
  <h3>Configuração da Arma</h3>

  <div class="form-group">
    <label>Proficiência</label>
    <select name="system.arma.proficiencia">
      {{#each proficienciasArma}}
        <option value="{{value}}" {{#if (eq ../system.arma.proficiencia value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>Propósito</label>
    <select name="system.arma.proposito">
      {{#each propositosArma}}
        <option value="{{value}}" {{#if (eq ../system.arma.proposito value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>Empunhadura</label>
    <select name="system.arma.empunhadura">
      {{#each empunhadurasArma}}
        <option value="{{value}}" {{#if (eq ../system.arma.empunhadura value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>Consumível</label>
    <select name="system.arma.consumivel">
      {{#each consumiveisArma}}
        <option value="{{value}}" {{#if (eq ../system.arma.consumivel value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>Munição / Recurso Atual</label>
    <input type="number" name="system.arma.municaoAtual" value="{{system.arma.municaoAtual}}" min="0" />
  </div>
</section>

<section class="jk-item-detail-section">
  <h3>Propriedades</h3>
  <div class="form-group jk-item-checkbox-grid">
    <label><input type="checkbox" name="system.arma.propriedades.adaptavel" {{checked system.arma.propriedades.adaptavel}} /> Adaptável</label>
    <label><input type="checkbox" name="system.arma.propriedades.agil" {{checked system.arma.propriedades.agil}} /> Ágil</label>
    <label><input type="checkbox" name="system.arma.propriedades.alongada" {{checked system.arma.propriedades.alongada}} /> Alongada</label>
    <label><input type="checkbox" name="system.arma.propriedades.desbalanceada" {{checked system.arma.propriedades.desbalanceada}} /> Desbalanceada</label>
    <label><input type="checkbox" name="system.arma.propriedades.dupla" {{checked system.arma.propriedades.dupla}} /> Dupla</label>
    <label><input type="checkbox" name="system.arma.propriedades.versatil" {{checked system.arma.propriedades.versatil}} /> Versátil</label>
    <label><input type="checkbox" name="system.arma.propriedades.hibrida" {{checked system.arma.propriedades.hibrida}} /> Híbrida</label>
  </div>
</section>

<section class="jk-item-detail-section">
  <header class="jk-item-section-header">
    <h3>Rolagens</h3>
  </header>

  <div class="jk-roll-config-block">
    <h4>Ataque</h4>
    <div class="form-group jk-roll-row">
      <label>Atributo</label>
      <select name="system.arma.ataque.atributo">
        {{#each atributos}}
          <option value="{{value}}" {{#if (eq ../system.arma.ataque.atributo value)}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>

      <label>Bônus</label>
      <input type="text" name="system.arma.ataque.bonus" value="{{system.arma.ataque.bonus}}" placeholder="+0" pattern="[+-]?[0-9]+" />
    </div>
  </div>

  <div class="jk-roll-config-block">
    <header class="jk-item-inline-header">
      <h4>Dano</h4>
      <button class="jk-item-add-damage" type="button" title="Adicionar dano"><i class="fas fa-plus"></i></button>
    </header>

    {{#each weaponDamages as |dano|}}
      <div class="form-group jk-roll-row jk-damage-row" data-key="{{dano.key}}">
        <input type="text" name="system.arma.danos.{{dano.key}}.formula" value="{{dano.formula}}" placeholder="ex. 1d8" />

        <select name="system.arma.danos.{{dano.key}}.atributo">
          {{#each ../atributos}}
            <option value="{{value}}" {{#if (eq dano.atributo value)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>

        <select name="system.arma.danos.{{dano.key}}.tipo">
          {{#each ../tiposDano}}
            <option value="{{value}}" {{#if (eq dano.tipo value)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>

        <button class="jk-item-remove-damage" type="button" data-key="{{dano.key}}" title="Remover dano"><i class="fas fa-trash"></i></button>
      </div>
    {{/each}}
  </div>

  <div class="jk-roll-config-block">
    <h4>Crítico</h4>
    <div class="form-group jk-roll-row">
      <label>Margem</label>
      <input type="number" name="system.arma.critico.margem" value="{{system.arma.critico.margem}}" placeholder="20" />
      <label>Multiplicador</label>
      <input type="number" name="system.arma.critico.multiplicador" value="{{system.arma.critico.multiplicador}}" placeholder="2" />
    </div>
  </div>

  <div class="form-group">
    <label>Alcance</label>
    <select name="system.arma.alcance">
      {{#each alcances}}
        <option value="{{value}}" {{#if (eq ../system.arma.alcance value)}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
</section>

