<section class="jk-item-section jk-structured-item-details">
  <h2>Dados do Feitiço</h2>
  <div class="jk-item-grid jk-item-grid--2">
    <label><span>Nível</span><input name="system.feitico.nivel" type="number" min="0" value="{{system.feitico.nivel}}" /></label>
    <label><span>Custo de PE</span><input name="system.feitico.custoPE" type="number" min="0" value="{{system.feitico.custoPE}}" /></label>
    <label><span>Tipo</span><input name="system.feitico.tipo" type="text" value="{{system.feitico.tipo}}" /></label>
    <label><span>Conjuração</span><input name="system.feitico.conjuracao" type="text" value="{{system.feitico.conjuracao}}" /></label>
    <label><span>Alcance</span><input name="system.feitico.alcance" type="text" value="{{system.feitico.alcance}}" /></label>
    <label><span>Alvo</span><input name="system.feitico.alvo" type="text" value="{{system.feitico.alvo}}" /></label>
    <label><span>Área</span><input name="system.feitico.area" type="text" value="{{system.feitico.area}}" /></label>
    <label><span>Duração</span><input name="system.feitico.duracao" type="text" value="{{system.feitico.duracao}}" /></label>
    <label><span>Teste</span><input name="system.feitico.teste" type="text" value="{{system.feitico.teste}}" /></label>
    <label><span>Resistência</span><input name="system.feitico.resistencia" type="text" value="{{system.feitico.resistencia}}" /></label>
    <label><span>Dados</span><input name="system.feitico.dados" type="text" value="{{system.feitico.dados}}" placeholder="Ex.: 2d8" /></label>
    <label><span>Bônus de Dano</span><input name="system.feitico.bonusDano" type="text" value="{{system.feitico.bonusDano}}" /></label>
  </div>
</section>

